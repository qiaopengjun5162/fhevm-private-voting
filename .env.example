# Hardhat deployment configuration
# Copy this file to .env and fill in your real values
# .env is gitignored — never commit real credentials

# --- Wallet (choose one) ---
# Option 1: Private key (recommended, single account)
PRIVATE_KEY=""

# Option 2: Mnemonic (generates multiple accounts)
# MNEMONIC="test test test test test test test test test test test junk"

# --- Sepolia RPC (choose one) ---
# Option 1: Direct RPC URL (Alchemy, Infura, or public endpoint)
SEPOLIA_RPC_URL=""

# Option 2: Infura API key (used to construct Infura URL)
# INFURA_API_KEY="your_infura_api_key_here"

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY="your_etherscan_api_key_here"
